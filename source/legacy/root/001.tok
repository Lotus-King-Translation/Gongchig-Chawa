དམ་ཆོས་ དགོངས་པ་ གཅིག་པ འི་ གསུང་ བརྒྱ་ ལྔ་ གསུང་ རྣམས་ ཚིགས་ དུ་པ་ བཞུགས་ གཞུང་ །_།རྡོ་རྗེ འི་ གསུང་ བརྒྱ་ ལྔ་ བཅུ་བ་ ཞེས་ བྱ་བ །_།སྟོབས་ བཅུ འི་ དབང་ཕྱུག་ ཤཱཀྱ་ སེང་གེ་ ལ་ ཕྱག་ འཚལ་ ལོ །_།དྲི་མེད་ འོད་གསལ་ ཐུགས་ ཀྱི་ དཀྱིལ་འཁོར་ དུ །_།མ་ འདྲེས་ ཤེས་བྱ འི་ དངོས་པོ་ ཇི་ལྟ་བ །_།ཐམས་ཅད་ གཟིགས་པ་ ཀུན་མཁྱེན་ ཆོས་ ཀྱི་ རྗེ །_།མཉམ་མེད་ འབྲི་གུང་ རིན་ཆེན་ ཕྱག་ འཚལ་ ལོ །_།རྒྱལ་བ་ མཆོག་ གི་ ཞལ་ ནས་ གསུངས་པ་ ཡི །_།དམ་ཆོས་ ཁྱད་འཕགས་ ཐུན་མོང་ མ་ཡིན་པ །_།སྔོན་ དུ་ མཛད་པ འི་ བཞེད་ཚུལ་ དཔག་མེད་ ཀྱང་ །_།རྨོངས་པ ས་ དྲན་པ་ ཅུང་ཟད་ ཙམ་ ཞིག་ བྲི །_།ཆོས་ ཀུན་ གཤིས་ སམ་ བབས་ ཀྱི་ གནས་ལུགས་ བསྟན །_།ཆོས་ཕུང་ བརྒྱད་ ཁྲི་ སངས་རྒྱས་ སྒྲུབ་པ ར་ གཅིག _།སྡེ་སྣོད་ རྒྱུད་སྡེ་ ལམ་ གྱི་ རིམ་པ་ ཡིན །_།ཆོས་འཁོར་ རྣམ་ གསུམ་ འཁོར་ གྱི་ རྟོགས་པ འི་ ཁྱད །_།འཁོར་ལོ་ རེ་རེ་ ལ་ ཡང་ གསུམ་ ག་ ཚང་ །_།ཕྱི་མ འི་ ས་བོན་ སྔ་མ་ སྔ་མ ར་ གནས །_།མདོ་དོན་ གནད་ ཀྱིས་ འཁོར་ལོ་ གསུམ་ དུ་ ངེས །_།འདུལ་བ འི་ སྡེ་སྣོད་ བདེན་ བཞི འི་ ཆོས་འཁོར་ ཏེ །_།ཐེག་པ་ སྣ་ཚོགས་ ངེས་དོན་ འཁོར་ལོ་ ཡིན །_།མཐའ་ དྲུག་ དགོངས་པ་ ངེས་དོན་ འབའ་ཞིག་ བཞེད །_།སེམས་ ཙམ་ བཀའ་ ཡིས་ མཐའ་བྲལ་ དབུ་མ་ སྟོན །_།ལོག་པ འི་ ཀུན་རྫོབ་ ཀྱིས་ ཀྱང་ དོན་ བྱེད་ ནུས །_།ཇི་སྙེད་ ལམ་ རྣམས་ ས་བཅུ ས་ བགྲོད་པ་ སྟེ །_།དེ་ཡང་ རིམ་གྱིས་ འཇུག་པ་ ཁོ་ན ར་ ངེས །_།ཤེས་བྱ འི་ སྒྲིབ་པ་ ཐོག་མ ར་ སྤོང་བ འང་ ཡོད །_།ཚད་མ་ སངས་རྒྱས་ མཁྱེན་པ འི་ ཡེ་ཤེས་ ཏེ །_།ཚད་མ འི་ འབྲས་བུ ས་ ཟབ་མོ་ སྟོང་ཉིད་ སྟོན །_།གྲུབ་མཐའ་ འཛིན་པ་ ཐམས་ཅད་ རང་རྒྱུད་པ །_།མུ་སྟེགས་པ་ ལ འང་ དགེ་བ འི་ བསྒྲུབ་བྱ་ མང་ །_།ཕྱི་ ནང་ ཁྱད་པར་ སྐྱབས་འགྲོ ས་ འབྱེད་པ་ སྟེ །_།ཐེག་པ་ ཆེ་ཆུང་ ཁྱད་པར་ སེམས་བསྐྱེད་ ཡིན །_།མདོ་ དང་ སྔགས་ ཀྱི་ ཁྱད་པར་ དབང་ ཡིན་ ཏེ །_།དེ་ གཉིས་ གང་ མེད་ རྫོགས་ བྱང་ ཐོབ་ མི་ སྲིད །_།སྡོམ་ གསུམ་ མི་དགེ་ བཅུ་ སྤོང་ གནད་ གཅིག་ ལ །_།བདག་པོ་ འཕོས་པ ས་ སྡོམ་པ་ གསུམ་ དུ་ འོང་ །_།རང་བཞིན་ རྣམ་དག་ བྲལ་འབྲས་ ཡོན་ཏན་ ལྡན །_།བྱང་ཕྱོགས་ སོ་ བདུན་ བདེ་གཤེགས་ སྙིང་པོ་ ཡོད །_།ཚད་ མེད་ རྣམ་ བཞི་ སངས་རྒྱས་ ངོ་བོ་ ཉིད །_།ཐེག་པ་ ཐམས་ཅད་ རིགས་ གཅིག་ ཐེག་པ ར་ གཅིག _།ཉན་རང་ ལོག་ སྲེག་ ཅན་ ཡང་ རྣམ་མཁྱེན་ འགྱུར །_།ཆོས་འཁོར་ གནད་བསྡུས་ ཀྱི་ སྐབས་ ཏེ་ དང་པོ འོ །_།དགེ་སྡིག་ གཉིས་ ལས་ ལུང་ མ་ བསྟན་ གཞན་ མེད །_།རྟོག་ གཉིས་ ཅིག་ཅར་ འཇུག་པ་ མི་ སྲིད་ ལ །_།སེམས་བྱུང་ ལས་ ཀྱང་ སེམས་ ནི་ འབྱུང་བ འང་ ཡོད །_།འཁོར་བ འི་ རྒྱ་མཚོ ར་ ལུས་ ཉིད་ འཁོར་བ ར་ བཞེད །_།རྟེན་འབྲེལ་ བཅུ་གཉིས་ མ་རིག་ ཁོ་ན འི་ གཡོས །_།བཅུ་གཉིས་ དེ་ཡང་ སྐད་ཅིག་ གཅིག་ ལ་ ཚང་ །_།སེམས་ ནི་ ཐ་དད་ དབང་ གི་ སྣང་བ་ ཡང་ །_།ད་ལྟ་ ཉིད་ དུ་ གང་ བསྒྲུབས་ འབྲས་བུ ར་ སྤྱོད །_།དུས་ ཀྱི་ འཕེལ་འགྲིབ་ ད་ལྟར་ བྱ་ ཡོད་ ཡིན །_།ཚེ་ འདི་རང་ ལ་ མཐོང་ཆོས་ གཙོ་བོ ར་ འབྱུང་ །_།མི་ཆོས་ བཅུ་དྲུག་ ལྷ་ཆོས་ གནད་ གཅིག་ སྟེ །_།གཙོ་ཕལ་ ཙམ་ ལས་འབྲས་ ཐོབ་ རྒྱུན་ ཆད་ མེད །_།ཤེས་རབ་ བསླབ་པ་ ཐོག་མ ར་ འགྲོ་བ འང་ ཡོད །_།ལམ་རིམ་ ཐམས་ཅད་ ཐུན་ གཅིག་ ཉམས་ལེན་ དགོས །_།ཞིང་ གཅིག་ ལ་ ཡང་ སངས་རྒྱས་ གྲངས་མེད་ འབྱོན །_།རྟེན་འབྲེལ་ གནད་བསྡུས་ ཀྱི་ སྐབས་ ཏེ་ གཉིས་པ འོ །_།དམ་ཆོས་ འདུལ་བ་ ཐེག་པ་ ཐུན་མོང་ སྟེ །_།ལྷག་པར་ ཐེག་པ་ ཆེན་པོ ར་ གསལ་ བཞུགས་ ལ །_།ཐམས་ཅད་ མཁྱེན་པ འི་ ཡེ་ཤེས་ འདི་ཉིད་ ཡིན །_།བར་ཆད་ ལྡན་ ལ འང་ སྡོམ་པ་ སྐྱེ་ ངེས་ ཏེ །_།ངོ་_བོ་ རྣམ་པ ར་ རིག་བྱེད་ མིན་པ འི་ གཟུགས །_།ལྟུང་བ་ མཐའ་དག་ ལ་ ནི་ འདུ་ཤེས་ གཙོ །_།ཡིད་ ཀྱི་ རྣམ་ གསུམ་ གཙོ་བོ ར་ སྤོང་བ་ དགོས །_།གཏོང་བ འི་ རྒྱུ་ ཡིས་ མི་ གཏོང་བ་ ཡང་ ཡོད །_།ཕམ་པ་ བཞི་ ནི་ བུ་ལོན་ ནོར་ ཅན་ བཞིན །_།སྣ་ གཅིག་ བསྲུངས་པ ས་ འབྲས་བུ་ མྱང་འདས་ འཐོབ །_།བཅས་ དང་ རང་བཞིན་ ཁ་ན་མ་ཐོ་ གཅིག _།སྡིག་ལྟུང་ ཐ་དད་ མེད་ ཅིང་ གཅིག་པ་ ཡིན །_།བཀག་པ་ ཡེ་ བཀག་ གནང་བ་ ཡེ་ གནང་ ལ །_།ཆོས་ ཀྱི་ རྒྱལ་པོ ས་ འགྲོ་བ་ སྤྱི་ ལ་ བཅས །_།འགྲོ་བ་ གང་ གིས་ འདས་ ཀྱང་ ཉེས་པ་ དང་ །_།བསྲུངས་པ འི་ ཕན་ཡོན་ ཡང་ ནི་ ཀུན་ ལ་ འབྱུང་ །_།བསྟན་ ལ་ ཆོ་ག་ ལྷག་པར་ གལ་ཆེ་ ལ །_།མི་ ཤེས་ གཏི་མུག་ ཉེས་པ་ གཞན་ ལས་ ལྕི །_།དུད་འགྲོ་ གཏི་མུག་ ཆེ་བ ས་ དམན་པ་ ཡིན །_།ཉམས་ ལས་མ་ ཐོབ་ ཉེས་པ་ ཆེ་བ ར་ བཞེད །སོ་ཐར་ གནད་བསྡུས་ ཀྱི་ སྐབས་ ཏེ་ གསུམ་པ འོ །_།བྱང་ཆུབ་ སེམས་ དང་ སྙིང་རྗེ་ ཐ་དད་ ཡིན །_།བྱང་ཆུབ་ སེམས་དཔ འི་ སྡོམ་པ་ རྟེན་ ཅན་ བཞེད །_།སོ་སོ་ སྐྱེ་བོ་ ལ་ ཡང་འཇུག་ སྡོམ་ སྐྱེ །_།ཅི་རིགས་ ཀྱིས་ ཀྱང་ འཇུག་པ འི་ སྡོམ་པ ར་ འགྱུར །_།ཉོན་མོངས་ ཅན་ མིན་ ལྟུང་བ་ མི་ སྲིད་ ཅིང་ །_།ཉེས་པ ར་ མི་ འགྱུར་ མི་དགེ་ གནང་བ་ མེད །_།ཐབས་མཁས་ སྤྱོད་ ལ་ མི་དགེ་ ཡོད་ མ་ ཡིན །_།རང་གཞན་ བརྗེ་བ་ ཉེས་པ་ འགྱུར་ སྐབས་ ཡོད །_།སེམས་དཔ ར་ གནོད་ བྱས་ བདེ་བ ར་ མི་ འབྲེལ་ ཞིང་ །_།དགེ་ དང་ མི་དགེ འི་ འབྲས་བུ་ སོ་སོ ར་ འབྱུང་ །_།བྱང་ཆུབ་ སེམས་ ནི་ བརྗེད་ ལས་ འཆོར་ མི་ སྲིད །_།སྒྲིབ་པ་ རྣམ་ གསུམ་ ཉོན་མོངས་ སྒྲིབ་པ་ གཅིག _།ཇི་སྙེད་ གྲུབ་པ ས་ དོན་དམ་ བདེན་པ་ བསྒྲིབས །_།ཉན་ཐོས་ ཀྱིས་ ཀྱང་ གནས་ལུགས་ ཕྱོགས་ གཅིག་ མཐོང་ །_།ས་ དྲུག་ མན་ཆད་ ཉན་རང་ ཐུན་མོང་ སྟེ །_།སེམས་ ཙམ་པ་ ནི་ ས་ བདུན་ མངོན་རྟོགས་ ཡིན །_།ཆོས་ ཀྱི་ བདག་མེད་ ས་_ བརྒྱད་ མངོན་དུ་ བྱས །_།རྟོགས་པ་ གཅིག་ གིས་ ས་ལམ་ མ་ ལུས་ བགྲོད །_།ས་ ཐོབ་ ཡོན་ཏན་ འབྱུང་ ཚུལ་ མུ་ དྲུག་ ཡོད །_།གཞི་ ལམ་ འབྲས་བུ ར་ ཚོགས་ གཉིས་ ཟུང་འཇུག་ ནས །_།མཐོ་དམན་ ཀུན་ ཏུ་ ཞིང་ ནི་ གདམས་པ་ ཟབ །_།བདག་ ཏུ་ བཟུང་ སྟེ་ ཚོགས་ བསགས་ ཐབས་མཁས་ བཞེད །_།འཁོར་འདས་ ཀུན་ གྱིས་ བསགས་ ཡོད་ དགེ་བ་ བསྔོ །_།སངས་རྒྱས་ བླ་མ་ ལ་ ཡང་ བསྔོ་བ་ དགོས །_།བྱང་སེམས་ གནད་བསྡུས་ ཀྱི་ སྐབས་ ཏེ་ བཞི་བ འོ །_།གསང་སྔགས་ བསྟན་པ་ གཞན་ ལ འང་ འབྱུང་བ་ ཡོད །_།དབང་དོན་ རྒྱུད་ ལ་ སྐྱེས་ ནས་ ཐོབ་པ ར་ བཞེད །_།ལྷ་ ནི་ ཕྱོགས་ གཅིག་པ ས་ ཀྱང་ དབང་ བསྐུར་ འགྲོ །_།རྟོགས་པ་ མ་ སྐྱེས་ དཔེ་ དོན་ ཁོང་ མི་ ཆུད །_།བསྐྱེད་པ འི་ རིམ་པ་ གདོད་ ནས་ ཡོངས་སུ་ གྲུབ །_།རང་བྱུང་ རྣམས་ ལ་ འཇུག་པ འི་ ཆོ་ག་ དགོས །_།ལྷ་ རྣམས་ ཐམས་ཅད་ མཚན་དཔེ འི་ ཡོན་ཏན་ ལྡན །_།མདོ་ རྒྱུད་ ལས་ གསུང་ ལྷ་ རྣམས་ གཙོ་བོ ར་ བྱ །_།དབང་པོ་ རབ་ ལ་ ཆོ་ག་ རྒྱས་པ་ དགོས །_།སྤྲོས་པ་ ཐམས་ཅད་ བབས་ ཀྱི་ རྟེན་འབྲེལ་ ཡིན །_།རྡོ་རྗེ འི་ ལུས་ ནི་ ཟབ་མོ འི་ འཁོར་ལོ ར་ བཞེད །_།གནས་ ལུག་ འགའ་ཞིག་ རྡོ་རྗེ་ འཆང་ གིས་ སྦ ས །_།ལས་ དང་ འདུག་ ཚུལ་ འགའ་ཞིག་ སྨན་ རྒྱུད་ ཟབ །_།གཞན་ གྱི་ མི་ ཟབ་པ་ རྣམས་ འདི ར་ ཟབ་ སྟེ །_།དེ་ མེད་ རྩ་ རླུང་ གདམས་པ ས་ སངས་ མི་ རྒྱ །_།བཀའ་ དང་ འགལ་བ འི་ ཉམས་མྱོང་ ལོག་རྟོག་ ཡིན །_།དགོངས་པ་ ཐམས་ཅད་ འགལ་ མེད་ ཤེས་པ ར་ དགོས །_།གདམས་ངག་ ལྟར་ མིན་ བཀའ་ ལྟར་ འོང་བ ར་ བཞེད །_།སྐྱོན་མེད་ ཏིང་འཛིན་ ཁམས་ གསུམ་ འཁོར་བ འི་ རྒྱུ །_།སྐུ་གསུམ་ རེ་རེ་ ལ་ ཡང་ གཞན་ གཉིས་ ཚང་ །_།གསང་སྔགས་ ལ་ ནི་ ཚུལ་ཁྲིམས་ མེད་ ཀ་མེད །_།འདོད་པ ས་ བར་ དུ་ གཅོད་པ་ མདོ་སྔགས་ གཅིག _།སྔགས་ ཀྱི་ མི་དགེ་ དགེ་བ ར་ འགྱུར་ སྐབས་མེད །_།འདུལ་བ ར་ མི་དགེ་ སྔགས་ སུ འང་ དགེ ར་ མི་ འགྱུར །_།ཉོན་མོངས་ དག་ འབྲས་ བདེ་བ ར་ གཤེགས་པ་ ཉིད །_།མཐུ་ བསྟན་ ཙམ་ ལས་ མངོན་སྤྱོད་ གནང་བ་ མེད །_།རྡོ་རྗེ་ དམྱལ་བ་ མནར་མེད་ ལ་སོགས་ ཡིན །_།སློབ་དཔོན་ རྒྱུད་ ཚོད་ མཐོ་ ན་ མྱུར་ དུ་ འདྲེན །_།སློབ་དཔོན་ རྒྱུད་ ཚོད་ མཐོ་ ན་ མྱུར་ དུ་ འདྲེན །_།༈_ དམ་པ འི་ ཆོས་ གང་ བརྒྱུད་པ ར་ འབྲེལ་པ་ ཟབ །_།འཁོར་འདས་ ཆོས་ ཀུན་ རང་ གི་ སེམས་ སྣང་ ཙམ །_།རྒྱུ་འབྲས་ སྐད་ཅིག་ བསམ་པ འི་ རང་གཟུགས་ ཡིན །_།གཤིས་ ལ་ མི་ གནས་ བལྟས་པ འི་ འགྱུར་ མི་ སྲིད །_།མཚན་ཉིད་ མི་ ལྡན་ ཡོན་ཏན་ སྐྱེད་ མི་ ནུས །_།རྟོགས་པ་ སྐྱེད་ ཐབས་ མོས་གུས་ ཁོ་ན ར་ ངེས །_།ལྟ་བ འི་ མཆོག་གྱུར་ རྟོགས་པ་ དང་ ལྡན་པ །_།ཆེན་པོ་ གསུམ་ གྱིས་ མ་ རེག་ རྟོགས་པ འི་ མཆོག _།ཐོས་བསམ་ སྒོམ་པ འི་ སྟོང་ཉིད་ ཤོལ་ གོལ་ ཡིན །_།རྟོགས་པ་ གོམས་པ ར་ བྱེད་པ་ སྒོམ་པ་ སྟེ །_།སྤྱོད་པ་ བླང་དོར་ བྲལ་བ་ ཚུལ་ཁྲིམས་ བཞེད །_།ལྟ་ སྒོམ་ སྤྱོད་ གསུམ་ ཐ་དད་ མེད་པ ར་ གཅིག _།ཕྱག་ ཆེན་ ཚུལ་ཁྲིམས་ གནད་ གཅིག་ ཁྱད་པར་ ཆོས །_།ཕྱག་ ཆེན་ ཡོན་ཏན་ ཀུན་ གྱི་ བདག་ཉིད་ དེ །_།མཉམ་པ ར་ བཞག་ ལས་ ཡོན་ཏན་ ཐམས་ཅད་ འབྱུང་ །_།རྒྱུ་ ནི་ མ་ བསྒྲུབས་ ཡོན་ཏན་ འབྱུང་ མི་ སྲིད །_།སྟོང་ཉིད་ རྟོགས་ ན་ རྒྱུ་འབྲས་ ཉིད་ དུ་ ལྡང་ །_།རྟོགས་ལྡན་ ལ་ ཡང་ ཐམས་ ལམ་ ལྷག་པར་ དགོས །_།རིགས་ སྤྱོད་ ཁྱད་ དུ་ འཕགས་པ་ ཚུལ་ཁྲིམས་ ཡིན །_།ཆོས་ གསུམ་ མི་ ལྡན་ ཉན་རང་ ཁྱད་པར་ མེད །_།ལྟ་ སྒོམ་ སྤྱོད་པ་ གནད་བསྡུས་ ཀྱི་ སྐབས་ ཏེ་ དྲུག་པ འོ །_།སངས་རྒྱས་ ས་ ན་ བདེན་ གཉིས་ རྣམ་དབྱེ ར་ མེད །_།མཁྱེན་པ འི་ ཡེ་ཤེས་ གཉིས་ མེད་ མཐའ་ དང་ བྲལ །_།རྒྱུ་མ་ ལྟ་བུ འི་ ཆོས་ ལས་ ཡང་དག་ འདས །_།སངས་རྒྱས་ དུས་ རྣམས་ རྟག་ ཏུ་ ཚད་མ ར་ བཞུགས །_།བྲལ་བ འི་ འབྲས་བུ ས་ ཡེ་ཤེས་ ཐུགས་ ཅན་ བཞེད །_།ཆོས་སྐུ་ ཡོན་ཏན་ མཛད་པ་ ཕྲིན་ལས་ བཅས །_།མཐར་ཐུག་ སངས་རྒྱས་ ས་ ན འང་ ཐུགས་བསྐྱེད་ ཡོད །_།ཐུགས་ ནི་ རྟག་ཆད་ ལྟ་བ་ ཚུན་ ལ འང་ འབྱུང་ །_།ཤེས་བྱ་ སྲིད་ ཚད་ སངས་རྒྱས་ བྱ་བ་ བྱེད །_།ཆོས་དབྱིངས་ ཀུན་ ཏུ་ འཚང་ རྒྱ་ དགོས་པ ར་ བཞེད །_།རྒྱུ་ མེད་ སྤྲུལ་པ་ མི་ སྲིད་ རང་རྒྱུད་པ །_།སངས་རྒྱས་ ཞེས་ བྱ་ རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ སྐུ །_།སྨོན་ འཇུག་ ལོངས་ སྤྲུལ་ རྒྱུ་ རུ་ བཞེད་པ འང་ ཡོད །_།སྐུ་གསུམ་ ཐ་དད་ མེད་ ཅིང་ བཞུགས་པ་ ཡིན །_།སངས་རྒྱས་ ཐམས་ཅད་ སེམས་ཅན་ རྒྱུད་ ལ་ བཞུགས །_།འབྲས་བུ་ གནད་བསྡུས་ ཀྱི་ སྐབས་ ཏེ་ བདུན་པ འོ །_།ཇི་ལྟར་ འཇིག་རྟེན་ འདི་ ན་ ཕ་ ཡི་ བུ །_།ལོངས་སྤྱོད་ ཕལ་པ འི་ འབྱོར་བ་ ལྡན་ གྱུར་ ཀྱང་ །_།ཕ་ ཡིས་ ཁྱད་ནོར་ གཞན་ ལ་ མེད་པ་ དགམ་ ཐོས་ མི་ འཛིན་ དེ་ ནི་ སྨད་པ་ ལྟར །_།དེ་བཞིན་ མཚུངས་མེད་ འཇིག་རྟེན་ མགོན་པོ་ ཡིས །_།མངོན་དུ་ མཛད་པ འི་ ཁྱད་པར་ ཆོས་ འདི་ དང་ །_།སྔོན་ཆད་ མ་ གྲགས་ ཕྱི་དུས་ འཇིག་རྟེན་ འདི ར །_།རྗེས་ འབྲང་ སྲས་ ཀྱིས་ མི་ འཛིན་ དེ་ དང་ མཚུངས །_།དེ་ཕྱིར་ རིགས་ལྡན་ ཕ་ ཡི་ གདུང་འཚོབ་པ །_།རིགས་ འཚོལ་ གཞན་ ལ་ སྨོད་པ ར་ མི་ བྱེད་ ཅིང་ །_།གྲགས་ ལྡན་ དེ་ ཡི་ བཞེད་པ འི་ ཐུགས་དགོངས་ རྣམས །_།ནན་ཏན་ ཆེན་པོ ས་ འཛིན་པ་ ངོ་མཚར་ ཆེ །_།བསྟན་འཛིན་ ཆོས་མཛད་ སྐྱེས་བུ་ དམ་པ་ རྣམས །_།བུ་ སྟོང་ ནང་ དུ་ འཁོར་ལོ ས་ སྒྱུར་ རྒྱལ་ གྱི །_།མཚན་ལྡན་ སྲས་ ནི་ ཁྱད་པར་ འཕགས་པ་ བཞིན །_།བསྟན་པ འི་ སྒོར་ ཞུགས་ ཀུན་ གྱི་ ནང་ ན་ མཛེས །_།ཐུན་མོང་ མ་ ཡིན་ དམ་པ འི་ སྙིང་པོ་ དང་ །_།རབ་འབྱམས་ ཐུབ་པ འི་ བཀའ་ ལ་མ་ རྨོངས་པ ས །_།ཕྱི་རོལ་ རྒོལ་བ་ ངན་པ འི་ ཝ་ ཚོགས་ ཀྱིས །_།གངས་ཅན་ སེང་གེ་ ལྟ་བུ ར་ ཉམས་ ང་ མེད །_།རིགས་ མཐུན་ འཁོར་ དང་ སྣ་ཚོགས་ གདུལ་བྱ་ ལ །_།མ་ འདྲེས་ ཆོས་ ཀྱི་ ཁྱད་པར་ ལེགས་ བསྟན་པ །_།དམན་ དང་ མཆོག་ གི་ བྱེ་བྲག་ རབ་ ཕྱེ་ སྟེ །_།སྙན་པ འི་ སྒྲ་ ཆེན་ འབྲུག་སྒྲ་ ཕྱོགས་ བཅུར་ སྒྲོགས །_།དེ་ལྟར་ ཟབ་ ཅིང་ རྒྱ་ ཆེ་ བླ་མེད་པ འི །_།དགོངས་པ་ རྒྱ་མཚོ་ ཆེ་ ལྟར་ ཡངས་པ་ ལས །_།སྐྲ་རྩེ འི་ ཆུ་ཐིགས་ ཙམ་ ཞིག་ སྨྲས་པ་ འདི །_།བན་ ལྡོམ་ ཤེས་རབ་ འབྱུང་གནས་ བདག་ གིས་ བྲིས །_།རྣམ་དག་ གངས་རི་ ལྟར་ དཀ ར་ དགེ་བ་ འདི ས །_།རིན་ཆེན་ བསྟན་པ་ ཕྱོགས་ བཅུར་ རྒྱས་པ་ དང་ །_།འཇིག་རྟེན་ མི་ ཤེས་ གཏི་མུག་ རྣམ་ བྲལ་ ཞིང་ །_།མཐར་ཕྱིན་ སངས་རྒྱས་ ཡེ་ཤེས་ ཐོབ་པ ར་ ཤོག །_།_།_།ཅེས་པ་ འདི་ ནི་ སྤྱན་སྔ་ ཤེས་རབ་ འབྱུང་གནས་ ཀྱིས་ མཛད་པ འི་ གཞུང་ དེ་ཉིད་ སོར་བཞག་ ལ །_།རང་གཞན་ འཇུག་པ་ བདེ་ ཕྱིར །རྡོ་རྗེ འི་ གསུང་ ཚིགས་བཅད་ དུ་ བསྡེབས་ ཏེ །_།ཆོས་ ཀྱི་ རྗེ་ སྐྱོབ་པ་ ཡབ་ སྲས་ ཀྱི་ བསྟན་པ་ ལ་ དད་པ འི་ བློ་ ཅན་ དཀོན་མཆོག་ རིན་ཆེན་ ཕྲིན་ལས་ རྣམ་པ ར་ རྒྱལ་བ འི་ སྡེ ས་ ཁྱི་ལོ་ ཧོར་ ཟླ་ དང་པོ འི་ ཉེར་ གསུམ་ ལ་ ཁམས་ ཀྱི་ བེ་ རི་ཐང་ གི་ སྒར་ ཐོག་ ཏུ་ བྲིས་བ འོ །།_།།